datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  passwordHash   String?
  phone          String?
  role           String          @default("CUSTOMER") // CUSTOMER, SELLER, ADMIN
  avatar         String?
  language       String          @default("en") // en, hi
  whatsappOptIn  Boolean         @default(false)
  whatsappOptInAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlist       WishlistItem[]
  artisanProfile ArtisanProfile?
  customOrders   CustomOrder[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ArtisanProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshopName      String
  workshopNameHi    String?
  story             String
  storyHi           String?
  craftCluster      String    // e.g. "Tamta Mohalla, Almora, Uttarakhand"
  craftClusterHi    String?
  yearsOfExperience Int       @default(15)
  certificationUrl  String?
  pan               String?
  gstin             String?
  bankAccount       String?
  bankIfsc          String?
  bankName          String?
  commissionRate    Float     @default(12.0) // 12% marketplace commission
  isApproved        Boolean   @default(false)
  rating            Float     @default(4.9)
  totalSalesCount   Int       @default(0)
  totalEarnings     Float     @default(0.0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  products          Product[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  nameHi      String
  slug        String    @unique
  description String
  image       String
  order       Int       @default(0)
  products    Product[]
}

model Product {
  id                   String           @id @default(uuid())
  title                String
  titleHi              String
  slug                 String           @unique
  description          String
  descriptionHi        String
  categoryId           String
  category             Category         @relation(fields: [categoryId], references: [id])
  artisanId            String
  artisan              ArtisanProfile   @relation(fields: [artisanId], references: [id])
  basePrice            Float
  comparePrice         Float?
  purityRating         String           @default("99.2% Lab-Certified Pure Copper")
  finish               String           // HAMMERED, PLAIN, ENGRAVED
  capacity             String?          // e.g. "1000ml", "2.5 Litres"
  weightGrams          Int              @default(650)
  dimensions           String           @default("28cm x 12cm")
  makingTimeDays       Int              @default(4)
  stock                Int              @default(15)
  isFeatured           Boolean          @default(false)
  isBestseller         Boolean          @default(false)
  images               String           // JSON stringified array of image URLs
  videoUrl             String?
  careInstructions     String
  safetyNotice         String           @default("Traditionally used in Ayurveda. Store only water and dry foodstuffs. Avoid acidic substances (lemon, tamarind, curd) in unlined copper.")
  customOrderAvailable Boolean          @default(false)
  qrCodeUrl            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  variants             ProductVariant[]
  reviews              Review[]
  orderItems           OrderItem[]
  wishlistItems        WishlistItem[]
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  nameHi     String
  capacity   String?
  finish     String?
  price      Float
  stock      Int      @default(10)
  sku        String   @unique
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  guestEmail      String?
  guestPhone      String?
  shippingAddress String      // JSON string of address
  subtotal        Float
  shippingFee     Float       @default(0.0)
  discount        Float       @default(0.0)
  giftWrapFee     Float       @default(0.0)
  isGift          Boolean     @default(false)
  giftMessage     String?
  totalAmount     Float
  paymentStatus   String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod   String      @default("RAZORPAY") // RAZORPAY, COD
  paymentId       String?
  orderStatus     String      @default("PLACED") // PLACED, CONFIRMED, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  trackingNumber  String?
  carrier         String?     @default("Shiprocket (BlueDart Express)")
  whatsappOptIn   Boolean     @default(false)
  whatsappOptInAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  variantId  String?
  title      String
  price      Float
  quantity   Int      @default(1)
  finish     String?
  capacity   String?
  artisanId  String
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName         String
  rating           Int      @default(5)
  title            String?
  comment          String
  images           String?  // JSON string
  verifiedPurchase Boolean  @default(true)
  artisanReply     String?
  createdAt        DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // PERCENTAGE, FLAT
  discountValue Float
  minOrderValue Float     @default(0.0)
  maxDiscount   Float?
  isActive      Boolean   @default(true)
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
}

model CustomOrder {
  id                 String   @id @default(uuid())
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  name               String
  email              String
  phone              String
  utensilType        String
  specifications     String
  engravingText      String?
  quantity           Int      @default(1)
  budgetRange        String?
  referenceImageUrl  String?
  status             String   @default("PENDING") // PENDING, QUOTED, ACCEPTED, IN_PRODUCTION, COMPLETED, CANCELLED
  quoteAmount        Float?
  quoteNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  titleHi     String
  slug        String   @unique
  excerpt     String
  excerptHi   String
  content     String
  contentHi   String
  coverImage  String
  author      String
  tags        String   // comma separated
  readTime    String   @default("5 min read")
  publishedAt DateTime @default(now())
}

model PincodeService {
  id           String  @id @default(uuid())
  pincode      String  @unique
  city         String
  state        String
  codAvailable Boolean @default(true)
  deliveryDays Int     @default(4)
}

model WhatsAppConversation {
  id                    String            @id @default(uuid())
  customerPhone         String            @unique
  customerName          String?
  status                String            @default("OPEN") // OPEN, WAITING_HUMAN, ASSIGNED, RESOLVED
  assignedAgent         String?
  linkedOrderId         String?
  linkedProductId       String?
  lastCustomerMessageAt DateTime          @default(now())
  optedIn               Boolean           @default(false)
  optedInAt             DateTime?
  optOutAt              DateTime?
  language              String            @default("en") // en, hi
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  messages              WhatsAppMessage[]
}

model WhatsAppMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String               // INBOUND, OUTBOUND
  messageType    String               @default("TEXT") // TEXT, TEMPLATE, QUICK_REPLY, INTERACTIVE, MEDIA
  body           String
  templateName   String?
  waMessageId    String?              @unique
  status         String               @default("SENT") // SENT, DELIVERED, READ, FAILED
  errorMessage   String?
  rawPayload     String?              // JSON payload for audit & compliance
  createdAt      DateTime             @default(now())
}


